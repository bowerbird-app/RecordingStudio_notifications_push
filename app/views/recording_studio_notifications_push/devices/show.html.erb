<%
  content_for(:title, push_t("devices.title"))
  installations_payload = @installations.map { |installation|
    {
      id: installation.id,
      firebase_installation_id: installation.firebase_installation_id
    }
  }
  secondary_actions = capture do
%>
      <% if @notifications_settings_path.present? %>
        <%= render FlatPack::Button::Component.new(
          text: push_t("devices.manage"),
          style: :default,
          size: :md,
          href: @notifications_settings_path
        ) %>
      <% end %>
<% end %>
<%= render FlatPack::Stack::Component.new(
      gap: :md,
      data: {
        controller: "recording-studio-notifications-push--push-devices",
        recording_studio_notifications_push__push_devices_register_url_value: installations_path,
        recording_studio_notifications_push__push_devices_unregister_url_template_value: "#{installations_path}/:id",
        recording_studio_notifications_push__push_devices_vapid_key_value: @vapid_public_key.to_s,
        recording_studio_notifications_push__push_devices_firebase_config_value: (@firebase_web_config || {}).to_json,
        recording_studio_notifications_push__push_devices_firebase_ready_value: @firebase_ready,
        recording_studio_notifications_push__push_devices_installations_value: installations_payload.to_json,
        recording_studio_notifications_push__push_devices_copy_value: push_js_copy.to_json
      }.tap { |attrs|
        if @service_worker_path.present?
          attrs[:recording_studio_notifications_push__push_devices_service_worker_path_value] = @service_worker_path
        end
      }
    ) do %>
  <%= render FlatPack::PageTitle::Component.new(
    title: push_t("devices.title"),
    subtitle: push_t("devices.subtitle"),
    variant: :h1
  ) %>

  <% if @firebase_ready %>
    <%= render FlatPack::Cluster::Component.new(gap: :sm, align: :center) do %>
      <div data-recording-studio-notifications-push--push-devices-target="enablePanel">
        <%= render FlatPack::Button::Component.new(
          text: push_t("devices.enable_browser"),
          style: :primary,
          size: :md,
          type: "button",
          data: { push_enable: true }
        ) %>
      </div>
      <%= secondary_actions %>
    <% end %>
    <%= render FlatPack::Text::Component.new(
      size: :sm,
      style: :muted,
      class: "hidden",
      role: "status",
      data: { recording_studio_notifications_push__push_devices_target: "status" }
    ) %>
  <% else %>
    <%= render FlatPack::Stack::Component.new(gap: :md) do %>
      <%= render FlatPack::Alert::Component.new(
        style: :warning,
        title: push_t("devices.unconfigured_title"),
        description: push_t("devices.unconfigured_body")
      ) %>
      <%= secondary_actions %>
    <% end %>
  <% end %>

  <% if @installations.any? %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <% @installations.each do |installation| %>
        <% remove_button = capture do %>
          <%= render FlatPack::Button::Component.new(
            icon: "trash",
            icon_only: true,
            style: :ghost,
            size: :sm,
            href: device_path(installation),
            aria: { label: push_t("devices.remove") },
            data: {
              turbo_method: :delete,
              turbo_confirm: push_t("devices.remove_confirm")
            }
          ) %>
        <% end %>
        <%= render FlatPack::List::Item.new(
          icon: installation.list_icon,
          trailing: remove_button,
          style: "padding-inline: 0"
        ) do %>
          <%= render FlatPack::Stack::Component.new(gap: :sm) do %>
            <%= render FlatPack::Text::Component.new(size: :sm, weight: :medium) do %>
              <span data-installation-id="<%= installation.id %>">
                <%= installation.display_label %>
                <span class="hidden" data-installation-current-label> · <%= push_t("devices.current") %></span>
              </span>
            <% end %>
            <% if installation.last_seen_at.present? %>
              <%= render FlatPack::Text::Component.new(
                text: push_t("devices.last_seen", time: time_ago_in_words(installation.last_seen_at)),
                size: :xs,
                style: :muted
              ) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
