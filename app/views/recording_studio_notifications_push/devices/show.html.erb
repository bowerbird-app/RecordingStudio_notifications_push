<%= render FlatPack::PageNav::Component.new(
  anchor_url: (main_app.root_path rescue "/")
) %>

<div class="mx-auto flex w-full max-w-2xl flex-col gap-6"
     data-controller="recording-studio-notifications-push--push-devices"
     data-recording-studio-notifications-push--push-devices-register-url-value="<%= installations_path %>"
     data-recording-studio-notifications-push--push-devices-unregister-url-template-value="<%= installations_path %>/:id"
     data-recording-studio-notifications-push--push-devices-vapid-key-value="<%= @vapid_public_key.to_s %>"
     data-recording-studio-notifications-push--push-devices-firebase-config-value="<%= (@firebase_web_config || {}).to_json %>"
     data-recording-studio-notifications-push--push-devices-firebase-ready-value="<%= @firebase_ready %>">

  <%= render FlatPack::PageTitle::Component.new(
    title: "Push devices",
    subtitle: "Turn on browser alerts for this account. You can silence a device anytime.",
    variant: :h1
  ) %>

  <% if @firebase_ready %>
    <div class="flex flex-wrap items-center gap-3">
      <%= render FlatPack::Button::Component.new(
        text: "Enable on this browser",
        style: :primary,
        size: :md,
        type: "button",
        data: { action: "recording-studio-notifications-push--push-devices#enable" }
      ) %>
      <p class="text-sm text-(--surface-content-color)"
         data-recording-studio-notifications-push--push-devices-target="status"></p>
    </div>
  <% else %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: "Firebase is not configured yet",
      description: "Set the FIREBASE_* environment variables to enable real browser registration. For local demos you can still paste a Firebase installation id below."
    ) %>

    <div class="flex flex-col gap-3">
      <%= render FlatPack::TextInput::Component.new(
        name: "manual_fid",
        label: "Firebase installation id",
        placeholder: "Paste a FID for local testing",
        data: { recording_studio_notifications_push__push_devices_target: "manualFid" }
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Register this id",
        style: :primary,
        size: :md,
        type: "button",
        data: { action: "recording-studio-notifications-push--push-devices#registerManualFid" }
      ) %>
      <p class="text-sm text-(--surface-content-color)"
         data-recording-studio-notifications-push--push-devices-target="status"></p>
    </div>
  <% end %>

  <% if @installations.any? %>
    <%= render FlatPack::PageTitle::Component.new(
      title: "This account",
      subtitle: "Active browsers and devices.",
      variant: :h3
    ) %>

    <ul class="flex flex-col gap-3">
      <% @installations.each do |installation| %>
        <li class="flex items-start justify-between gap-4 border-b border-(--surface-border-color) pb-3">
          <div class="min-w-0">
            <p class="truncate text-sm font-medium text-(--surface-content-color)">
              <%= installation.label.presence || installation.platform.presence || "Browser" %>
            </p>
            <p class="mt-1 truncate text-xs text-(--surface-content-color)">
              <%= installation.firebase_installation_id %>
            </p>
            <% if installation.last_seen_at.present? %>
              <p class="mt-1 text-xs text-(--surface-content-color)">
                Last seen <%= time_ago_in_words(installation.last_seen_at) %> ago
              </p>
            <% end %>
          </div>
          <%= button_to "Remove",
                        device_path(installation),
                        method: :delete,
                        form: { data: { turbo_confirm: "Stop push alerts on this device?" } },
                        class: "text-sm underline" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-(--surface-content-color)">No devices yet. Enable push on a browser to get started.</p>
  <% end %>
</div>
