<%= render FlatPack::Stack::Component.new(gap: :lg) do %>
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "Firebase web values, the send key, and a few timeouts. ENV is usually enough.",
    variant: :h1
  ) %>

  <%= render FlatPack::Alert::Component.new(
    style: :info,
    title: "Defaults from ENV",
    description: "The install generator writes an initializer. Leave most keys commented and set FIREBASE_* in the environment unless you need an override."
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(title: "Initializer") %>
  <%= render FlatPack::Text::Component.new(
    text: "config/initializers/recording_studio_notifications_push.rb".gsub("/", "/\u200B"),
    size: :sm,
    style: :muted
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "Ruby",
    language: :ruby,
    wrap: true,
    code: <<~'CODE'
      RecordingStudioNotificationsPush.configure do |config|
        # Channel key registered with RecordingStudioNotifications.
        config.channel = :push

        # Optional overrides — ENV is the usual source.
        # config.firebase_project_id = ENV.fetch("FIREBASE_PROJECT_ID", nil)
        # config.vapid_public_key = ENV.fetch("FIREBASE_VAPID_PUBLIC_KEY", nil)
        # config.firebase_service_account_json = ENV.fetch("FIREBASE_SERVICE_ACCOUNT_JSON", nil)
        # config.firebase_web_config = {
        #   apiKey: ENV.fetch("FIREBASE_API_KEY"),
        #   appId: ENV.fetch("FIREBASE_APP_ID"),
        #   authDomain: ENV.fetch("FIREBASE_AUTH_DOMAIN"),
        #   messagingSenderId: ENV.fetch("FIREBASE_MESSAGING_SENDER_ID"),
        #   projectId: ENV.fetch("FIREBASE_PROJECT_ID"),
        #   storageBucket: ENV.fetch("FIREBASE_STORAGE_BUCKET")
        # }

        # HTTP timeouts for FCM / Google OAuth (seconds).
        # config.open_timeout = 5
        # config.read_timeout = 15
        # config.write_timeout = 15
      end
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Settings",
    subtitle: "What each knob does."
  ) %>

  <% push_settings = [
    { setting: "channel", default: ":push", detail: "Name registered with the parent notifications gem." },
    { setting: "firebase_web_config", default: "FIREBASE_*", detail: "Browser Firebase config used to get a messaging token." },
    { setting: "firebase_project_id", default: "FIREBASE_PROJECT_ID", detail: "FCM HTTP v1 project. Falls back to the web config projectId." },
    { setting: "vapid_public_key", default: "FIREBASE_VAPID_PUBLIC_KEY", detail: "Web Push certificate key for getToken." },
    { setting: "firebase_service_account_json", default: "FIREBASE_SERVICE_ACCOUNT_JSON", detail: "Full service-account JSON. Required to send. UI can register without it." },
    { setting: "open_timeout", default: "5", detail: "Seconds to open the FCM / OAuth HTTP connection." },
    { setting: "read_timeout", default: "15", detail: "Seconds to wait for an FCM / OAuth response." },
    { setting: "write_timeout", default: "15", detail: "Seconds to write the request body." }
  ] %>
  <%= render FlatPack::Table::Component.new(data: push_settings, min_width: :md) do |table| %>
    <% table.column(title: "Setting", html: ->(row) { tag.code(row[:setting]) }) %>
    <% table.column(title: "Default", html: ->(row) { tag.code(row[:default]) }) %>
    <% table.column(title: "What it does", html: ->(row) { row[:detail] }) %>
  <% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Environment keys",
    subtitle: "Map straight onto the web config and send credentials."
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "Environment",
    language: :bash,
    wrap: true,
    code: <<~'CODE'
      FIREBASE_API_KEY=…
      FIREBASE_APP_ID=…
      FIREBASE_AUTH_DOMAIN=…
      FIREBASE_MESSAGING_SENDER_ID=…
      FIREBASE_PROJECT_ID=…
      FIREBASE_STORAGE_BUCKET=…
      FIREBASE_VAPID_PUBLIC_KEY=…
      FIREBASE_SERVICE_ACCOUNT_JSON=…   # required to send
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Missing service account",
    subtitle: "Registration still works. Sends do not."
  ) %>

  <%= render FlatPack::Text::Component.new(size: :sm) do %>
    Leave
    <code>FIREBASE_SERVICE_ACCOUNT_JSON</code>
    blank while you build the devices UI. The first real send raises
    <code>RecordingStudioNotificationsPush::DeliveryError</code>
    until that JSON is set.
  <% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Inspect at runtime",
    subtitle: "Safe summary — the service-account JSON is never dumped."
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "Console",
    language: :ruby,
    wrap: true,
    code: <<~'CODE'
      RecordingStudioNotificationsPush.configuration.to_h
      # => {
      #   channel: :push,
      #   firebase_project_id: "…",
      #   firebase_web_config: { apiKey: "…", … },
      #   vapid_public_key: "…",
      #   firebase_service_account_configured: true,
      #   open_timeout: 5,
      #   read_timeout: 15,
      #   write_timeout: 15
      # }
    CODE
  ) %>
<% end %>
