<%# The select submits on change. A second submit button stacks under it and doubles the top bar. %>
<%= form_with url: recording_studio_internationalization.locale_path, method: :patch, data: { turbo: false }, **html_options do |form| %>
  <%= form.hidden_field :return_to, value: request.fullpath %>
  <%= render FlatPack::Select::Component.new(
        name: "locale",
        label: t("recording_studio.internationalization.selector.label"),
        options: locales.map { |locale| [locale.name, locale.code.to_s] },
        value: I18n.locale.to_s,
        placeholder: nil
      ) %>
<% end %>
