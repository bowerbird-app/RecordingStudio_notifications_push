<%
  icon_url = @notification.metadata.is_a?(Hash) && (@notification.metadata["icon"] || @notification.metadata[:icon])
%>
<%= render FlatPack::List::Component.new(divider: true) do %>
  <%= render FlatPack::List::Item.new do %>
    <%= render FlatPack::Stack::Component.new(gap: :sm) do %>
      <% if icon_url.present? %>
        <%= image_tag icon_url, alt: "", width: 40, height: 40 %>
      <% end %>
      <%= render FlatPack::Cluster::Component.new(gap: :sm, align: :center, justify: :between) do %>
        <%= render FlatPack::Text::Component.new(text: @notification.title, size: :sm, weight: :medium) %>
        <%= render FlatPack::Text::Component.new(
          text: "#{time_ago_in_words(@notification.created_at)} ago",
          size: :xs,
          style: :muted
        ) %>
      <% end %>
      <% if @notification.body.present? %>
        <%= render FlatPack::Text::Component.new(text: @notification.body, size: :sm) %>
      <% end %>
      <%= render FlatPack::Cluster::Component.new(gap: :sm, align: :center) do %>
        <% if @deliveries.any? %>
          <% @deliveries.each do |delivery| %>
            <%= render FlatPack::Badge::Component.new(
              text: "#{delivery.channel} · #{delivery.status}",
              size: :sm
            ) %>
          <% end %>
        <% else %>
          <%= render FlatPack::Badge::Component.new(text: "none", size: :sm) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
