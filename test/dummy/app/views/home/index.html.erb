<% dummy_page_nav(title: "Push demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Push notifications",
    subtitle: "Dummy host for the Recording Studio Firebase push channel.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "Manage devices",
      style: :primary,
      size: :md,
      href: "/notifications/push/devices"
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Notification inbox",
      style: :secondary,
      size: :md,
      href: "/notifications"
    ) %>
  </div>

  <p class="text-sm leading-6 text-(--surface-content-color)">
    Enable push on a browser, then send a demo notice from the console with
    <code>RecordingStudioNotifications.notify</code> using type
    <code>:push_demo</code>.
  </p>
</div>
