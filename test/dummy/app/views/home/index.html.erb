<%= render FlatPack::Stack::Component.new(gap: :lg) do %>
  <%= render FlatPack::PageTitle::Component.new(
    title: t("dummy.home.title"),
    subtitle: t("dummy.home.subtitle"),
    variant: :h1
  ) %>

  <%= render FlatPack::Cluster::Component.new(gap: :sm) do %>
    <%= render FlatPack::Button::Component.new(
      text: "Manage devices",
      style: :secondary,
      size: :md,
      href: "/notifications/push/devices"
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Notification inbox",
      style: :secondary,
      size: :md,
      href: "/notifications"
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Notification settings",
      style: :secondary,
      size: :md,
      href: "/notifications/settings"
    ) %>
  <% end %>

  <%= render FlatPack::Stack::Component.new(gap: :sm) do %>
    <%= render FlatPack::Text::Component.new(size: :sm) do %>
      Each button sends a <strong>Push demo</strong> notice with a different banner
      thumbnail (<code>/push-icon-coral.png</code> or <code>/push-icon-teal.png</code>).
      Channels follow
      <%= link_to "notification settings", "/notifications/settings" %>.
      Enable
      <%= link_to "this browser under push devices", "/notifications/push/devices" %>
      first if you want the toast here.
      On <strong>macOS Chrome</strong>, the left badge stays the Chrome app icon — custom
      thumbnails show on Windows/Android (and sometimes as a small right-side image on macOS).
    <% end %>

    <%= render FlatPack::Cluster::Component.new(gap: :sm) do %>
      <%= form_with url: test_notifications_path(format: :turbo_stream), method: :post do %>
        <%= hidden_field_tag :icon, "coral" %>
        <%= render FlatPack::Button::Component.new(
          text: "Test coral icon",
          style: :primary,
          size: :md,
          type: "submit"
        ) %>
      <% end %>
      <%= form_with url: test_notifications_path(format: :turbo_stream), method: :post do %>
        <%= hidden_field_tag :icon, "teal" %>
        <%= render FlatPack::Button::Component.new(
          text: "Test teal icon",
          style: :default,
          size: :md,
          type: "submit"
        ) %>
      <% end %>
    <% end %>
  <% end %>

  <div id="test-notification-flash"></div>

  <%= render FlatPack::Stack::Component.new(gap: :sm, aria: { live: "polite" }) do %>
    <%= render FlatPack::SectionTitle::Component.new(
      title: "In-app inbox",
      subtitle: "Same rows as the notification inbox. Stay here to confirm in-app delivery."
    ) %>
    <div id="inbox-notifications">
      <%= render "home/inbox_notifications", notifications: @recent_inbox_notifications %>
    </div>
  <% end %>

  <%= render FlatPack::Stack::Component.new(gap: :sm, aria: { live: "polite" }) do %>
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Test results",
      subtitle: "Channel delivery status for pings from this page (clears on full reload)."
    ) %>
    <div id="test-notifications">
      <%= render FlatPack::EmptyState::Component.new(
        id: "test-notifications-empty",
        title: "No test pings yet",
        description: "Hit a button above.",
        size: :sm,
        width: :full,
        layout: :stack
      ) %>
    </div>
  <% end %>
<% end %>
