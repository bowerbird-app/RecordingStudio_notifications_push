<%= turbo_stream.update "test-notification-flash" do %>
  <%= render "test_notification_flash" %>
<% end %>

<%= turbo_stream.remove "test-notifications-empty" %>

<%= turbo_stream.prepend "test-notifications" do %>
  <%= render "test_notification" %>
<% end %>

<%= turbo_stream.update "inbox-notifications" do %>
  <%= render "inbox_notifications", notifications: @recent_inbox_notifications %>
<% end %>
