<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: t("dummy.sidebar.brand"),
      subtitle: t("dummy.sidebar.subtitle"),
      show_version: false
    ) %>
  <% end %>

  <% sidebar.items do %>
    <%# Phones open this drawer from the hamburger. The named switcher stays in the top bar from md up. %>
    <%= tag.div(class: "md:hidden") do %>
      <%= render_recording_studio_root_switch_list %>
    <% end %>
    <%= render FlatPack::Stack::Component.new(gap: :sm, role: "navigation", aria: { label: t("dummy.sidebar.nav") }) do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: t("dummy.sidebar.home"),
        href: main_app.root_path,
        icon: :home
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: t("dummy.sidebar.push_devices"),
        href: recording_studio_notifications_push.devices_path,
        icon: :device_phone_mobile
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: t("dummy.sidebar.inbox"),
        href: recording_studio_notifications.root_path,
        icon: :inbox
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: t("dummy.sidebar.notification_settings"),
        href: recording_studio_notifications.settings_path,
        icon: :adjustments_horizontal
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: t("dummy.sidebar.install"),
        href: main_app.docs_install_path,
        icon: :arrow_down_tray
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: t("dummy.sidebar.config"),
        href: main_app.docs_config_path,
        icon: :settings
      ) %>
    <% end %>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: t("dummy.sidebar.sign_out"),
        href: main_app.destroy_user_session_path,
        icon: :lock,
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
