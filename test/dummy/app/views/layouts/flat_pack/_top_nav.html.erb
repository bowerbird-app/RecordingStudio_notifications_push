<%
  themes = [
    { value: "rounded", label: t("dummy.theme.rounded", default: "Rounded") },
    { value: "system", label: t("dummy.theme.system", default: "System") },
    { value: "light", label: t("dummy.theme.light", default: "Light") },
    { value: "dark", label: t("dummy.theme.dark", default: "Dark") }
  ]
%>
<%= render FlatPack::TopNav::Component.new do |nav| %>
  <% nav.left do %>
    <%= render FlatPack::Button::Component.new(
      icon: "menu",
      icon_only: true,
      style: :ghost,
      size: :md,
      aria: { label: t("dummy.nav.toggle_sidebar", default: "Toggle sidebar") },
      data: {
        "flat-pack--sidebar-layout-target": "mobileToggle",
        action: "click->flat-pack--sidebar-layout#toggleMobile"
      },
      class: "md:hidden"
    ) %>
  <% end %>

  <% nav.center do %>
    <span aria-hidden="true"></span>
  <% end %>

  <% nav.right do %>
    <% if user_signed_in? %>
      <%= render FlatPack::Cluster::Component.new(gap: :sm, align: :center, class: "flex-nowrap") do %>
        <%# Desktop keeps the small select inline. Phones use the copy inside the cog. %>
        <%= tag.div(class: "hidden md:block") do %>
          <%= dummy_language_selector %>
        <% end %>
        <%# The theme controller rewrites the first dropdown label it finds. Keep it on the cog so the workspace switcher keeps its name. %>
        <%= tag.div(
          data: {
            controller: "flat-pack--theme",
            flat_pack__theme_themes_value: themes.to_json
          }
        ) do %>
          <%= dummy_theme_selector %>
        <% end %>

        <%= recording_studio_notifications_async_menu(recipient: current_user) %>

        <%# Below md the named switcher lives in the sidebar drawer so this row stays icons. %>
        <%= tag.div(class: "hidden md:flex") do %>
          <%= recording_studio_root_switch_dropdown(style: :ghost, size: :md) %>
        <% end %>

        <%= render FlatPack::Avatar::Component.new(
          name: current_user.try(:name).presence || current_user.email,
          size: :sm
        ) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
