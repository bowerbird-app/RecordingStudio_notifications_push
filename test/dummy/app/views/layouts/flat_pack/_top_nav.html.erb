<%= render FlatPack::TopNav::Component.new do |nav| %>
  <% nav.left do %>
    <%= render FlatPack::Button::Component.new(
      icon: "menu",
      icon_only: true,
      style: :ghost,
      size: :md,
      aria: { label: t("dummy.nav.toggle_sidebar", default: "Toggle sidebar") },
      data: {
        "flat-pack--sidebar-layout-target": "mobileToggle",
        action: "click->flat-pack--sidebar-layout#toggleMobile"
      },
      class: "md:hidden"
    ) %>
  <% end %>

  <% nav.center do %>
    <span aria-hidden="true"></span>
  <% end %>

  <% nav.right do %>
    <% if user_signed_in? %>
      <%= render FlatPack::Cluster::Component.new(gap: :sm, align: :center) do %>
        <%= dummy_language_selector %>
        <%# The theme controller rewrites the first dropdown label it finds. Keep it on the cog so the workspace switcher keeps its name. %>
        <div
          data-controller="flat-pack--theme"
          data-flat-pack--theme-themes-value='[{"value":"rounded","label":"<%= j t("dummy.theme.rounded", default: "Rounded") %>"},{"value":"system","label":"<%= j t("dummy.theme.system", default: "System") %>"},{"value":"light","label":"<%= j t("dummy.theme.light", default: "Light") %>"},{"value":"dark","label":"<%= j t("dummy.theme.dark", default: "Dark") %>"}]'
        >
          <%= dummy_theme_selector %>
        </div>

        <%= recording_studio_notifications_async_menu(recipient: current_user) %>

        <%= recording_studio_root_switch_dropdown(style: :ghost, size: :md) %>

        <%= render FlatPack::Avatar::Component.new(
          name: current_user.try(:name).presence || current_user.email,
          size: :sm
        ) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
