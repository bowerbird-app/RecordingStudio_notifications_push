source "https://rubygems.org"

# Use the recording_studio_notifications_push engine
gem "recording_studio_notifications_push", path: "../.."

gem "recording_studio_notifications", "~> 0.21",
    github: "bowerbird-app/RecordingStudio_notifications",
    tag: "v0.21.0"

# Notifications 0.21.0 depends on Recording Studio API (not on RubyGems).
# API needs Moveable and Icons.
# require: false keeps the API engine off this dummy. Loading it also loads
# Admin, and the devices metrics tests cover the path where Admin is absent.
gem "recording_studio_api", "~> 1.21",
    github: "bowerbird-app/RecordingStudio_api",
    tag: "v1.21.2",
    require: false
gem "recording_studio_moveable", "~> 6.1",
    github: "bowerbird-app/RecordingStudio_moveable",
    tag: "v6.1.0",
    require: false
gem "recording_studio_icons", "~> 0.5",
    github: "bowerbird-app/RecordingStudio_icons",
    tag: "v0.5.0",
    require: false

email_path = ENV.fetch("RECORDING_STUDIO_NOTIFICATIONS_EMAIL_PATH", nil)
if email_path && !email_path.strip.empty?
  gem "recording_studio_notifications_email", path: email_path
else
  gem "recording_studio_notifications_email",
      github: "bowerbird-app/RecordingStudio_notifications_email",
      tag: "v0.5.4"
end

gem "recording_studio_pwa", "~> 0.10",
    github: "bowerbird-app/RecordingStudio_PWA",
    tag: "v0.10.0"

gem "recording_studio", "~> 7.8", github: "bowerbird-app/RecordingStudio", tag: "v7.8.0"
gem "recording_studio_accessible", "~> 0.58", github: "bowerbird-app/RecordingStudio_accessible", tag: "v0.58.0"
gem "recording_studio_admin", "~> 2.20",
    github: "bowerbird-app/RecordingStudio_admin",
    tag: "v2.20.0",
    require: false
gem "recording_studio_logs", "~> 0.9",
    github: "bowerbird-app/RecordingStudio_logs",
    tag: "v0.9.0",
    require: false
# Accessible needs trashable query helpers only (not the full engine).
gem "recording_studio_trashable", "~> 1.3",
    github: "bowerbird-app/RecordingStudio_trashable",
    tag: "v1.3.0",
    require: false
gem "recording_studio_metrics", "~> 0.10", github: "bowerbird-app/RecordingStudio_metrics", tag: "v0.10.0"

# Root switcher for the top nav.
gem "recording_studio_cache", "~> 0.8", github: "bowerbird-app/RecordingStudio_cache", tag: "v0.8.0"
gem "recording_studio_root_switchable", "~> 0.17", github: "bowerbird-app/RecordingStudio_root_switchable", tag: "v0.17.0"

# Devise authentication
gem "devise"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.1"
# The modern asset pipeline for Rails [https://github.com/rails/propshaft]
gem "propshaft"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# Kamal pulls net-ssh; keep a patched release (GHSA coverage starts at 7.3.8).
gem "net-ssh", ">= 7.3.8"
# Use JavaScript with ESM import maps [https://github.com/rails/importmap-rails]
gem "importmap-rails"
# Hotwire's SPA-like page accelerator [https://turbo.hotwired.dev]
gem "turbo-rails"
# Hotwire's modest JavaScript framework [https://stimulus.hotwired.dev]
gem "stimulus-rails"
# Build JSON APIs with ease [https://github.com/rails/jbuilder]
gem "jbuilder"

# Use Tailwind CSS [https://github.com/rails/tailwindcss-rails]
gem "tailwindcss-rails"

# Dummy-only language switching. The push gem ships English; hosts own other languages.
gem "recording_studio_internationalization",
    github: "bowerbird-app/RecordingStudio_Internationalization",
    tag: "v0.3.0"

# FlatPack UI component library [https://github.com/bowerbird-app/flatpack]
gem "flat_pack", "~> 0.2", github: "bowerbird-app/flatpack", tag: "v0.2.0"
gem "view_component", "4.20.0"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Use the database-backed adapters for Rails.cache, Active Job, and Action Cable
gem "solid_cache"
gem "solid_queue"
gem "solid_cable"

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Deploy this application anywhere as a Docker container [https://kamal-deploy.org]
gem "kamal", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma
gem "thruster", require: false

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
gem "image_processing", "~> 1.2"

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "bundler-audit", require: false
  gem "brakeman", require: false
  gem "minitest-mock"
  gem "rubocop-rails-omakase", require: false
end

group :test do
  gem "capybara"
  gem "selenium-webdriver"
  gem "simplecov", "~> 0.22.0", require: false
end

group :development do
  gem "web-console"
end
